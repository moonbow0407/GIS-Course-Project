QMainWindow#mainWindow {
    background: #f5f7fa;
}

QDockWidget#workspacePanelDock,
QDockWidget#attributeTableDock,
QWidget#workspacePanelTabs,
QWidget#attributeTablePanel,
QWidget#analysisHistoryPanel,
QWidget#symbologyPanel {
    background: #ffffff;
    color: #263548;
}

QDockWidget#workspacePanelDock::title,
QDockWidget#attributeTableDock::title {
    padding: 7px 10px;
    border-bottom: 1px solid #d9e1ea;
    background: #eef4fa;
    color: #263548;
    font-family: "Microsoft YaHei UI", "Segoe UI";
    font-size: 14px;
    font-weight: 600;
}

QWidget#workspacePanelTitleBar,
QWidget#attributeTableTitleBar {
    min-height: 34px;
    background: #eef4fa;
    border-bottom: 1px solid #d9e1ea;
}

QLabel#workspacePanelTitle,
QLabel#attributeTableDockTitle {
    color: #263548;
    font-size: 14px;
    font-weight: 600;
}

QToolButton#workspacePanelFloatButton,
QToolButton#workspacePanelCloseButton,
QToolButton#attributeTableFloatButton,
QToolButton#attributeTableCloseButton {
    min-width: 30px;
    max-width: 30px;
    min-height: 28px;
    max-height: 28px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 4px;
    background: #eef4fa;
    color: #263548;
    font-family: "Segoe UI Symbol", "Microsoft YaHei UI", sans-serif;
    font-size: 16px;
    font-weight: 700;
}

QToolButton#workspacePanelFloatButton:hover,
QToolButton#workspacePanelCloseButton:hover,
QToolButton#attributeTableFloatButton:hover,
QToolButton#attributeTableCloseButton:hover {
    border-color: #9dc3e3;
    background: #dcecf9;
    color: #0f5f9f;
}

QToolButton#workspacePanelFloatButton:pressed,
QToolButton#workspacePanelCloseButton:pressed,
QToolButton#attributeTableFloatButton:pressed,
QToolButton#attributeTableCloseButton:pressed {
    border-color: #7eaed3;
    background: #c8e1f2;
    color: #0f4f86;
}

QTabWidget#workspacePanelTabs {
    background: #eef3f8;
    color: #263548;
}

QTabWidget#workspacePanelTabs::pane {
    border: none;
    background: #eef3f8;
    top: -1px;
}

QTabBar#workspacePanelTabBar {
    background: #eef4fa;
    border-bottom: 1px solid #d9e1ea;
}

QTabBar#workspacePanelTabBar::tab {
    min-width: 84px;
    min-height: 36px;
    padding: 0 10px;
    border: none;
    border-bottom: 3px solid transparent;
    background: #eef4fa;
    color: #526277;
    font-size: 13px;
}

QTabBar#workspacePanelTabBar::tab:hover {
    background: #e3eef8;
    color: #0f6cbd;
}

QTabBar#workspacePanelTabBar::tab:selected {
    background: #ffffff;
    color: #0f5f9f;
    border-bottom-color: #0f6cbd;
    font-weight: 600;
}

QWidget#attributeTablePanel {
    min-height: 190px;
    background: #ffffff;
    color: #263548;
}

QLabel#attributeTableLayerLabel {
    padding-left: 10px;
    color: #64748b;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#attributeTableQueryButton,
QPushButton#attributeTableAddButton,
QPushButton#attributeTableEditButton,
QPushButton#attributeTableDeleteButton,
QPushButton#attributeTableCloseButton {
    min-height: 28px;
    padding: 0 10px;
    border: 1px solid #bfcbd8;
    border-radius: 4px;
    background: #ffffff;
    color: #263548;
}

QPushButton#attributeTableQueryButton:hover,
QPushButton#attributeTableAddButton:hover,
QPushButton#attributeTableEditButton:hover,
QPushButton#attributeTableDeleteButton:hover,
QPushButton#attributeTableCloseButton:hover {
    border-color: #77a9d0;
    background: #edf5fc;
    color: #0f5f9f;
}

QPushButton#attributeTableDeleteButton:hover {
    border-color: #e0a28b;
    background: #fff4ef;
    color: #b45309;
}

QPushButton#attributeTableQueryButton:disabled,
QPushButton#attributeTableAddButton:disabled,
QPushButton#attributeTableEditButton:disabled,
QPushButton#attributeTableDeleteButton:disabled {
    border-color: #e1e7ee;
    background: #f3f6f9;
    color: #9aa8b7;
}

QWidget#analysisHistoryPanel {
    background: #ffffff;
    color: #263548;
}

QLabel#analysisHistorySubtitle {
    color: #64748b;
    font-size: 12px;
    font-weight: 500;
}

QPushButton#analysisHistoryClear {
    min-width: 52px;
    min-height: 26px;
    padding: 0 9px;
    border: 1px solid #cbd6e2;
    border-radius: 4px;
    background: #ffffff;
    color: #526277;
}

QPushButton#analysisHistoryClear:hover {
    border-color: #d97706;
    background: #fff7ed;
    color: #b45309;
}

QListWidget#analysisHistoryList {
    border: 1px solid #d9e1ea;
    background: #ffffff;
    alternate-background-color: #f8fafc;
    outline: none;
}

QListWidget#analysisHistoryList::item {
    min-height: 34px;
    padding: 0;
    border-bottom: 1px solid #eef2f6;
}

QListWidget#analysisHistoryList::item:hover {
    background: #edf5fc;
}

QListWidget#analysisHistoryList::item:selected {
    background: #dcecf9;
    color: #0f5f9f;
}

QWidget#analysisHistoryRow,
QLabel#analysisHistoryOperation,
QLabel#analysisHistoryStatus {
    background: transparent;
}

QLabel#analysisHistoryStatus {
    min-width: 20px;
    color: #64748b;
    font-size: 15px;
    font-weight: 700;
}

QLabel#analysisHistoryStatus[status="completed"] {
    color: #3b9b62;
}

QLabel#analysisHistoryStatus[status="failed"],
QLabel#analysisHistoryStatus[status="stale"] {
    color: #d86b3b;
}

QLabel#analysisHistoryOperation {
    color: #263548;
    font-size: 13px;
}

QWidget#symbologyScrollContent,
QScrollArea#symbologyScrollArea {
    background: #eef3f8;
}

QFrame#symbologyHeaderCard,
QFrame#symbologySettingsCard,
QFrame#symbologyClassesCard {
    border: 1px solid #d7e0e9;
    border-radius: 6px;
    background: #ffffff;
}

QLabel#symbologyTitle {
    border: none;
    background: transparent;
    color: #17263b;
    font-size: 16px;
    font-weight: 600;
}

QLabel#symbologyLayerMetadata {
    border: none;
    background: transparent;
    color: #64748b;
    font-size: 12px;
}

QLabel#symbologyPreview {
    border: none;
    border-radius: 5px;
    background: #f8fafc;
}

QLabel#symbologySectionTitle {
    border: none;
    background: transparent;
    color: #22344a;
    font-size: 13px;
    font-weight: 600;
}

QLabel#symbologyHint {
    border: none;
    background: transparent;
    color: #718096;
    font-size: 11px;
}

QLabel#symbologyClassCount {
    min-width: 38px;
    padding: 2px 7px;
    border: 1px solid #c8d7e6;
    border-radius: 9px;
    background: #eef5fb;
    color: #356587;
    font-size: 11px;
}

QLabel#symbologyAutoApplyStatus {
    padding: 8px 14px;
    border-top: 1px solid #d7e0e9;
    background: #f8fafc;
    color: #21845a;
    font-size: 12px;
}

QFrame#symbologySettingsCard QLabel {
    border: none;
    background: transparent;
    color: #475569;
}

QFrame#symbologyClassesCard QTableWidget {
    border: 1px solid #d7e0e9;
    border-radius: 4px;
}

QFrame#symbologyClassesCard QHeaderView::section {
    padding: 6px 7px;
    border: none;
    border-bottom: 1px solid #d7e0e9;
    background: #f3f6f9;
    color: #4b5f73;
    font-weight: 600;
}

QWidget {
    font-family: "Microsoft YaHei UI", "Segoe UI";
    font-size: 13px;
    color: #263548;
}

QWidget#ribbonBar {
    background: #ffffff;
    border-bottom: 1px solid #d9e1ea;
}

QLabel#panelTitle {
    color: #1e2f45;
    font-family: "Microsoft YaHei UI", "Segoe UI";
    font-size: 15px;
    font-weight: 600;
    padding: 1px 0 4px 0;
}

QTabBar#ribbonTabs {
    background: #ffffff;
    border-bottom: 1px solid #e2e8f0;
}

QTabBar#ribbonTabs::tab {
    min-width: 74px;
    min-height: 34px;
    padding: 0 8px;
    margin-left: 3px;
    color: #334155;
    background: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    font-size: 14px;
}

QTabBar#ribbonTabs::tab:hover {
    color: #0f6cbd;
    background: #f2f7fc;
}

QTabBar#ribbonTabs::tab:selected {
    color: #0f6cbd;
    background: #f7fbff;
    border-bottom: 3px solid #0f6cbd;
    font-weight: 600;
}

QWidget#ribbonPage {
    background: #ffffff;
}

QToolButton#ribbonButton {
    min-height: 62px;
    padding: 3px 6px 2px 6px;
    border: 1px solid transparent;
    border-radius: 5px;
    background: transparent;
    color: #25364b;
}

QToolButton#ribbonButton:hover {
    border-color: #cbdced;
    background: #edf5fc;
    color: #0f6cbd;
}

QToolButton#ribbonButton:pressed {
    background: #dcecf9;
}

QToolButton#ribbonButton:checked {
    border-color: #9cc7eb;
    background: #dcecf9;
    color: #0f6cbd;
}

QToolButton#ribbonButton:disabled {
    color: #b6c2d0;
    background: transparent;
    border: 1px solid transparent;
}

QToolButton#ribbonButton::menu-button {
    border: none;
    background: transparent;
}

QLabel#ribbonGroupCaption {
    color: #7b8797;
    font-size: 11px;
    padding: 0 5px 1px 5px;
}

QFrame#ribbonSeparator {
    color: #dce3eb;
    margin: 3px 7px 5px 7px;
}

QSplitter#mapWorkspaceSplitter::handle {
    background: #d9e1ea;
    width: 1px;
}

QSplitter#mainWorkspaceSplitter::handle:vertical {
    min-height: 7px;
    background: #d9e1ea;
    border-top: 1px solid #b8c9d9;
    border-bottom: 1px solid #b8c9d9;
}

QSplitter#mainWorkspaceSplitter::handle:vertical:hover {
    background: #8db6d5;
}

LayerPanel {
    background: #ffffff;
    border-right: 1px solid #d9e1ea;
}

QLabel#panelHint {
    color: #94a3b8;
    font-size: 11px;
}

QLineEdit#layerSearch {
    min-height: 32px;
    padding: 0 10px;
    border: 1px solid #cfd9e5;
    border-radius: 5px;
    background: #f8fafc;
    selection-background-color: #0f6cbd;
}

QLineEdit#layerSearch:focus {
    border-color: #0f6cbd;
    background: #ffffff;
}

QTreeWidget#layerTree {
    border: none;
    background: #ffffff;
    outline: none;
    alternate-background-color: #f8fafc;
}

QTreeWidget#layerTree::item {
    min-height: 31px;
    padding-left: 3px;
    border-radius: 4px;
}

QTreeWidget#layerTree::item:hover {
    background: #edf5fc;
}

QTreeWidget#layerTree::item:selected {
    background: #dcecf9;
    color: #0f5f9f;
}

LayerPanel QToolButton {
    min-width: 30px;
    min-height: 28px;
    border: 1px solid #d6dee8;
    border-radius: 4px;
    background: #ffffff;
    color: #526277;
    font-size: 16px;
}

LayerPanel QToolButton:hover {
    color: #0f6cbd;
    border-color: #9dc3e3;
    background: #edf5fc;
}

QGraphicsView {
    border: none;
    background: #f3f6fa;
}

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    min-height: 28px;
    padding: 2px 8px;
    border: 1px solid #cfd9e5;
    border-radius: 4px;
    background: #ffffff;
    color: #263548;
    selection-background-color: #dcecf9;
    selection-color: #0f5f9f;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #0f6cbd;
}

QTextEdit#rasterCalculatorExpression {
    min-height: 80px;
    padding: 6px 8px;
    border: 1px solid #cfd9e5;
    border-radius: 4px;
    background: #ffffff;
    color: #263548;
    selection-background-color: #dcecf9;
    selection-color: #0f5f9f;
}

QTextEdit#rasterCalculatorExpression:focus {
    border-color: #0f6cbd;
}

QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
    border-color: #9dc3e3;
}

QComboBox::drop-down {
    width: 26px;
    border: none;
    border-left: 1px solid #d9e1ea;
    background: #f8fafc;
}

QAbstractItemView,
QComboBox QAbstractItemView,
QListView,
QTreeView {
    border: 1px solid #cbd6e2;
    background: #ffffff;
    color: #263548;
    selection-background-color: #dcecf9;
    selection-color: #0f5f9f;
    outline: none;
}

QAbstractItemView::item,
QComboBox QAbstractItemView::item,
QListView::item,
QTreeView::item {
    min-height: 28px;
    padding: 4px 10px;
    background: #ffffff;
    color: #263548;
}

QAbstractItemView::item:selected,
QComboBox QAbstractItemView::item:selected,
QListView::item:selected,
QTreeView::item:selected {
    background: #dcecf9;
    color: #0f5f9f;
}

QAbstractItemView::item:hover,
QComboBox QAbstractItemView::item:hover,
QListView::item:hover,
QTreeView::item:hover {
    background: #edf5fc;
    color: #0f5f9f;
}

QToolTip {
    padding: 4px 8px;
    border: 1px solid #cbd6e2;
    background: #ffffff;
    color: #263548;
}

QMenu {
    min-width: 150px;
    padding: 4px;
    border: 1px solid #cbd6e2;
    border-radius: 6px;
    background: #ffffff;
    color: #263548;
}

QMenu::item {
    min-height: 28px;
    padding: 4px 18px;
    border-radius: 4px;
    background: #ffffff;
    color: #263548;
}

QMenu::item:selected {
    background: #dcecf9;
    color: #0f5f9f;
}

QMenu::separator {
    height: 1px;
    margin: 4px 8px;
    background: #d9e1ea;
}

QDialog,
QMessageBox {
    background: #ffffff;
    color: #263548;
}

QDialog#labelingDialog {
    background: #ffffff;
    color: #263548;
}

QDialog#labelingDialog QLabel,
QDialog#labelingDialog QCheckBox {
    background: #ffffff;
    color: #263548;
}

QFrame#labelingHeaderCard,
QFrame#labelingClassCard,
QFrame#labelingSettingsCard {
    border: 1px solid #d9e1ea;
    border-radius: 8px;
    background: #f8fafc;
    color: #263548;
}

QLabel#labelingTitle {
    background: #f8fafc;
    color: #17263b;
    font-size: 16px;
    font-weight: 600;
}

QLabel#labelingSectionTitle {
    background: #f8fafc;
    color: #22344a;
    font-size: 13px;
    font-weight: 600;
}

QLabel#labelingHint {
    background: #f8fafc;
    color: #526277;
}

QDialog#labelingDialog QListWidget,
QDialog#labelingDialog QLineEdit,
QDialog#labelingDialog QComboBox,
QDialog#labelingDialog QDoubleSpinBox {
    border: 1px solid #bfcbd8;
    border-radius: 4px;
    background: #ffffff;
    color: #263548;
    selection-background-color: #dcecf9;
    selection-color: #0f5f9f;
}

QDialog#labelingDialog QListWidget::item {
    min-height: 28px;
    padding: 4px 6px;
    background: #ffffff;
    color: #263548;
}

QDialog#labelingDialog QListWidget::item:selected {
    background: #dcecf9;
    color: #0f5f9f;
}

QDialog#labelingDialog QPushButton {
    min-height: 28px;
    border: 1px solid #bfcbd8;
    border-radius: 4px;
    background: #ffffff;
    color: #263548;
}

QDialog#labelingDialog QPushButton:hover {
    border-color: #0f6cbd;
    background: #edf5fc;
    color: #0f5f9f;
}

/* 对话框内未单独命名的容器（分组框、页签、页签页）统一使用浅色主题：
   系统深色模式下这些控件会回退到深色调色板，导致深色文字无法辨认。 */
QDialog QWidget {
    background: #ffffff;
    color: #263548;
}

QDialog QGroupBox {
    border: 1px solid #d9e1ea;
    border-radius: 6px;
    margin-top: 14px;
}

QDialog QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    color: #263548;
    font-weight: 600;
}

QDialog QTabWidget::pane {
    border: none;
    background: #ffffff;
}

QDialog QTabBar::tab {
    min-height: 30px;
    padding: 0 14px;
    border: 1px solid #d9e1ea;
    border-bottom: none;
    background: #f3f6f9;
    color: #526277;
}

QDialog QTabBar::tab:hover {
    background: #edf5fc;
    color: #0f6cbd;
}

QDialog QTabBar::tab:selected {
    background: #ffffff;
    color: #0f5f9f;
    font-weight: 600;
}

QDialog QLabel,
QMessageBox QLabel {
    background: transparent;
    color: #263548;
}

QTableView {
    border: 1px solid #d9e1ea;
    background: #ffffff;
    alternate-background-color: #f8fafc;
    color: #263548;
    gridline-color: #d9e1ea;
    selection-background-color: #dcecf9;
    selection-color: #0f5f9f;
}

QTableView::item {
    background: #ffffff;
    color: #263548;
    padding: 4px 6px;
}

QTableView::item:alternate {
    background: #f8fafc;
}

QTableView QScrollBar:vertical {
    width: 12px;
    margin: 2px 2px 2px 0;
    border: 1px solid #d9e1ea;
    border-radius: 5px;
    background: #eef4fa;
}

QTableView QScrollBar::handle:vertical {
    min-height: 28px;
    border-radius: 5px;
    background: #9eb5ca;
}

QTableView QScrollBar::handle:vertical:hover {
    background: #6f9bc0;
}

QTableView QScrollBar::add-page:vertical,
QTableView QScrollBar::sub-page:vertical {
    background: #eef4fa;
}

QTableView QScrollBar::add-line:vertical,
QTableView QScrollBar::sub-line:vertical {
    height: 14px;
    border: none;
    background: #dce8f2;
}

QTableView QScrollBar:horizontal {
    min-height: 14px;
    max-height: 14px;
    margin: 0 2px 2px 2px;
    border: 1px solid #d9e1ea;
    border-radius: 5px;
    background: #eef4fa;
}

QTableView QScrollBar::handle:horizontal {
    min-width: 36px;
    border-radius: 5px;
    background: #9eb5ca;
}

QTableView QScrollBar::handle:horizontal:hover {
    background: #6f9bc0;
}

QTableView QScrollBar::add-page:horizontal,
QTableView QScrollBar::sub-page:horizontal {
    background: #eef4fa;
}

QTableView QScrollBar::add-line:horizontal,
QTableView QScrollBar::sub-line:horizontal {
    width: 14px;
    border: none;
    background: #dce8f2;
}

QHeaderView::section {
    padding: 5px 8px;
    border: none;
    border-right: 1px solid #d9e1ea;
    border-bottom: 1px solid #d9e1ea;
    background: #eef4fa;
    color: #263548;
    font-weight: 600;
}

QFrame#emptyMapOverlay {
    background: rgba(255, 255, 255, 225);
    border: 1px solid #dce4ed;
    border-radius: 12px;
}

QLabel#emptyMapSymbol {
    color: #5d9fd3;
    font-family: "Segoe UI Symbol";
    font-size: 42px;
}

QLabel#emptyMapTitle {
    color: #2b3c51;
    font-size: 17px;
    font-weight: 600;
}

QLabel#emptyMapDescription {
    color: #7a899b;
    font-size: 12px;
}

QStatusBar#mainStatusBar {
    min-height: 30px;
    background: #ffffff;
    border-top: 1px solid #d9e1ea;
    color: #526277;
}

QStatusBar#mainStatusBar QLabel {
    padding: 0 10px;
    color: #526277;
    font-size: 12px;
}

QLabel#statusSeparator {
    color: #d5dde7;
    padding: 0;
}

QMessageBox QPushButton,
QDialog QPushButton {
    min-width: 76px;
    min-height: 28px;
    padding: 0 12px;
    border: 1px solid #bfcbd8;
    border-radius: 4px;
    background: #ffffff;
    color: #263548;
}

QMessageBox QPushButton:hover,
QDialog QPushButton:hover {
    color: #ffffff;
    border-color: #0f6cbd;
    background: #0f6cbd;
}
